# Shell-Skripte laufen im Linux-Container und brauchen LF-Zeilenenden, auch bei Checkout unter Windows
*.sh text eol=lf

# Windows-Startskript braucht CRLF, sonst stolpert cmd.exe über Sprungmarken
*.bat text eol=crlf

# Bilder sind Binärdateien: keine Umwandlung der Zeilenenden
*.png binary
*.ico binary
