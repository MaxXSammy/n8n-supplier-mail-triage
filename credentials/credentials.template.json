[
  {
    "id": "credTriagePg0001",
    "name": "Postgres Triage",
    "type": "postgres",
    "data": {
      "host": "postgres",
      "port": 5432,
      "database": "triage",
      "user": "${POSTGRES_USER}",
      "password": "${POSTGRES_PASSWORD}",
      "ssl": "disable"
    }
  },
  {
    "id": "credWebhookTok01",
    "name": "Webhook Token",
    "type": "httpHeaderAuth",
    "data": {
      "name": "X-Webhook-Token",
      "value": "${WEBHOOK_TOKEN}"
    }
  },
  {
    "id": "credReviewLogin1",
    "name": "Review Login",
    "type": "httpBasicAuth",
    "data": {
      "user": "${REVIEW_USER}",
      "password": "${REVIEW_PASSWORD}"
    }
  }
]
