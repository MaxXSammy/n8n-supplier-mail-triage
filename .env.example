# Vorlage: nach .env kopieren und die Geheimnisse ändern.

# Postgres: eine Instanz für die n8n-Daten (Datenbank n8n) und die Tickets (Datenbank triage)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=bitte-aendern

# n8n verschlüsselt damit gespeicherte Zugangsdaten. Nach dem ersten Start nicht mehr ändern.
N8N_ENCRYPTION_KEY=bitte-aendern-langer-zufallswert

# Token, das Absender im Header "X-Webhook-Token" mitschicken müssen
WEBHOOK_TOKEN=bitte-aendern

# Login für die Review-Seite und das Review-Formular (Human-in-the-loop)
REVIEW_USER=einkauf
REVIEW_PASSWORD=bitte-aendern

# LLM: Ollama auf dem Host (Standard) oder im Container (docker compose --profile ollama up)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Unter dieser Konfidenz geht eine Mail zur Prüfung an einen Menschen
KONFIDENZ_SCHWELLE=0.75
